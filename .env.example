# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Database
DATABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic (Phase 5 — AI coach, code review, question grading)
ANTHROPIC_API_KEY=

# Deepgram (Phase 6 — text-to-speech and speech-to-text)
DEEPGRAM_API_KEY=

# Resend (Phase 8 — email reminders)
RESEND_API_KEY=
RESEND_FROM_EMAIL=chrisseckler@gmail.com
RESEND_FROM_NAME=Interview Gym

# Cron (Phase 8 — Railway cron job auth)
CRON_SECRET=

# Web Push (Phase 10 — optional browser push notifications)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google OAuth is configured in the Clerk Dashboard (not here).
# See README.md Step 4b for Google Cloud setup when deploying to production.
