{
  "name": "interview-gym",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "ln -sf ../../.env.local apps/web/.env.local",
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "type-check": "npm run type-check --workspace=apps/web",
    "content:audit": "node scripts/content-audit.mjs",
    "db:migrate": "npm run db:migrate --workspace=packages/db",
    "db:studio": "npm run db:studio --workspace=packages/db",
    "db:reset": "npm run db:reset --workspace=packages/db",
    "db:generate": "npm run db:generate --workspace=packages/db",
    "cron": "npm run start --workspace=apps/cron",
    "test": "npm run test --workspace=apps/web",
    "test:watch": "npm run test:watch --workspace=apps/web",
    "test:coverage": "npm run test:coverage --workspace=apps/web"
  }
}
