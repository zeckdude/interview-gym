generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String           @id @default(cuid())
  clerkId     String           @unique
  email       String           @unique
  createdAt   DateTime         @default(now())
  attempts    Attempt[]
  preferences UserPreferences?
}

model Attempt {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  challengeId   String
  challengeType String
  language      String
  code          String?
  answer        String?
  passed        Boolean
  timeSpentMs   Int?
  aiCoachUsed   Boolean  @default(false)
  aiReviewUsed  Boolean  @default(false)
  aiImproveUsed Boolean  @default(false)
  hintUsed      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model UserPreferences {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  reminderEnabled   Boolean  @default(true)
  reminderFrequency String   @default("daily")
  reminderTime      String   @default("09:00")
  timezone          String   @default("America/Los_Angeles")
  updatedAt         DateTime @updatedAt
}
