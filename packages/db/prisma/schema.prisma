generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(cuid())
  clerkId           String                 @unique
  email             String                 @unique
  createdAt         DateTime               @default(now())
  attempts          Attempt[]
  preferences       UserPreferences?
  chatMessages      ChatMessage[]
  lessonProgress    LessonProgress[]
  streak            Streak?
  badges            Badge[]
  srItems           SpacedRepetitionItem[]
  simulatorSessions SimulatorSession[]
  personalBests     PersonalBest[]
  weakSpots         WeakSpot[]
  shareToken        ShareToken?
  notes             ChallengeNote[]
  userChallenges    UserChallenge[]
  generationJobs    ChallengeGenerationJob[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  mostAskedOverrides MostAskedOverride[]
  studyPlanItems     StudyPlanItem[]
  systemDesignSessions SystemDesignSession[]
  voiceInterviewSessions VoiceInterviewSession[]
  playbookProfile       PlaybookProfile?
  jobSearchCriteria     JobSearchCriteria?
  playbookEntries       PlaybookEntry[]
  playbookQuestions     PlaybookQuestion[]
  simulatorCompanyContexts SimulatorCompanyContext[]
  learningPaths           LearningPath[]
  learnModuleProgress     LearnModuleProgress[]
  learnConceptReviews     LearnConceptReview[]
  learnConceptWeights     LearnConceptWeight[]
  learnHintEvents         LearnHintEvent[]
}

model PlaybookProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  linkedInUrl        String?
  linkedInText       String?
  resumeText         String?
  portfolioUrl       String?
  githubUrl          String?
  personalWebsite    String?
  additionalContext  String?
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model JobSearchCriteria {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  targetRoles        String[]
  targetCompanyStage String[]
  targetIndustries   String[]
  preferredStack     String[]
  locationPreference String?
  salaryMin          Int?
  salaryMax          Int?
  mustHaves          String[]
  dealBreakers       String[]
  additionalNotes    String?
  updatedAt          DateTime @updatedAt
}

model PlaybookEntry {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id])
  category       String
  title          String
  summary        String?
  order          Int                  @default(0)
  isSeeded       Boolean              @default(false)
  questionPrompt String?
  subsections    PlaybookSubsection[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId, category])
}

model PlaybookSubsection {
  id              String        @id @default(cuid())
  entryId         String
  entry           PlaybookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  label           String
  textContent     String?
  audioUrl        String?
  transcript      String?
  fillerWordCount Int?
  wordsPerMinute  Float?
  aiFeedback      String?
  aiSummary       String?
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([entryId])
}

model PlaybookQuestion {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  category        String
  questionText    String
  isSystemDefault Boolean  @default(false)
  mostAsked       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([category, isSystemDefault])
}

model SimulatorCompanyContext {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  companyName     String?
  companyWebsite  String?
  jobListingUrl   String?
  jobListingText  String?
  additionalNotes String?
  researchSummary String?
  researchedAt    DateTime?
  interviewers    SimulatorInterviewer[]
  voiceSessions   VoiceInterviewSession[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([userId])
}

model SimulatorInterviewer {
  id              String                  @id @default(cuid())
  contextId       String
  context         SimulatorCompanyContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  name            String
  title           String?
  linkedInUrl     String?
  linkedInText    String?
  researchSummary String?
  rapportPoints   String[]
  researchedAt    DateTime?

  @@index([contextId])
}

model UserChallenge {
  id                  String                 @id @default(cuid())
  userId              String
  user                User                   @relation(fields: [userId], references: [id])
  title               String
  category            String
  difficulty          String
  description         String
  concepts            String[]
  starterCodeJs       String
  starterCodeTs       String
  solutionJs          String
  solutionTs          String
  lessonContent       String
  miniChallengePrompt String
  companyName         String?
  sourceDescription   String
  createdAt           DateTime               @default(now())
  attempts            UserChallengeAttempt[]

  @@index([userId, createdAt])
}

model UserChallengeAttempt {
  id          String        @id @default(cuid())
  userId      String
  challengeId String
  challenge   UserChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  passed      Boolean
  code        String?
  language    String
  createdAt   DateTime      @default(now())

  @@index([userId, challengeId])
}

model ChallengeNote {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  challengeId String
  content     String
  hintUsed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, challengeId])
}

model LessonProgress {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  lessonId            String
  completed           Boolean   @default(false)
  miniChallengePassed Boolean   @default(false)
  bestTimeMs          Int?
  attempts            Int       @default(0)
  lastAttemptAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, lessonId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  challengeId String
  role        String
  content     String
  createdAt   DateTime @default(now())

  @@index([userId, challengeId])
}

model Attempt {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  challengeId   String
  challengeType String
  language      String
  code          String?
  answer        String?
  passed        Boolean
  timeSpentMs   Int?
  aiCoachUsed   Boolean  @default(false)
  aiReviewUsed  Boolean  @default(false)
  aiImproveUsed Boolean  @default(false)
  hintUsed      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model UserPreferences {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  reminderEnabled   Boolean  @default(true)
  reminderFrequency String   @default("daily")
  reminderTime      String   @default("09:00")
  timezone          String   @default("America/Los_Angeles")
  updatedAt         DateTime @updatedAt
}

model Streak {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id])
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActivityAt     DateTime?
  freezesUsed        Int       @default(0)
  freezesAvailable   Int       @default(1)
  freezeAppliedFor   String?
  lastFreezeResetAt  DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Badge {
  id          String   @id @default(cuid())
  slug        String
  name        String
  description String
  emoji       String
  earnedAt    DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, slug])
}

model SpacedRepetitionItem {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  challengeId    String
  challengeType  String
  difficulty     String
  lastReviewedAt DateTime?
  nextReviewAt   DateTime
  intervalDays   Float     @default(1)
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, challengeId])
}

model SimulatorSession {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  difficulty      String
  category        String
  durationMinutes Int
  challengeCount  Int                  @default(4)
  startedAt       DateTime
  completedAt     DateTime?
  totalScore      Float?
  challenges      SimulatorChallenge[]

  @@index([userId, startedAt])
}

model SimulatorChallenge {
  id          String           @id @default(cuid())
  sessionId   String
  session     SimulatorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  challengeId String
  order       Int
  passed      Boolean?
  timeSpentMs Int?
  code        String?
  language    String?
  aiFeedback  String?
  createdAt   DateTime         @default(now())
}

model PersonalBest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  challengeId String
  bestTimeMs  Int
  achievedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, challengeId])
}

model WeakSpot {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  challengeId    String
  failedAttempts Int       @default(0)
  flaggedAt      DateTime  @default(now())
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?

  @@unique([userId, challengeId])
}

model ShareToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())
}

model ChallengeGenerationJob {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  status            String    @default("pending")
  statusMessage     String?
  sourceDescription String
  companyName       String?
  challengeId       String?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  @@index([userId, createdAt])
  @@index([userId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}

model MostAskedOverride {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String
  itemId    String
  mostAsked Boolean
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId])
}

model StudyPlanItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  String
  itemId    String
  source    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId, sortOrder])
}

model SystemDesignSession {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  challengeId     String
  challengeTitle  String
  startedAt       DateTime             @default(now())
  completedAt     DateTime?
  overallScore    Float?
  sectionScores   Json?
  aiFeedback      String?
  dialogHistory   Json?
  answers         SystemDesignAnswer[]

  @@index([userId, startedAt])
}

model SystemDesignAnswer {
  id              String              @id @default(cuid())
  sessionId       String
  session         SystemDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  section         String
  questionText    String              @default("")
  textContent     String?
  audioUrl        String?
  transcript      String?
  fillerWordCount Int?
  wordsPerMinute  Float?
  confidenceScore Float?
  createdAt       DateTime            @default(now())

  @@index([sessionId])
}

model VoiceInterviewSession {
  id                   String                   @id @default(cuid())
  userId               String
  user                 User                     @relation(fields: [userId], references: [id])
  category             String
  difficulty           String
  questionIds          Json
  sessionQuestionCount Int                      @default(1)
  includeFollowUps     Boolean                  @default(true)
  mostAskedOnly        Boolean                  @default(false)
  presetId             String?
  playbookCategories   Json?
  interviewType        String                   @default("voice")
  customQuestionTexts  Json?
  companyContextId     String?
  companyContext       SimulatorCompanyContext? @relation(fields: [companyContextId], references: [id])
  startedAt            DateTime                 @default(now())
  completedAt          DateTime?
  overallScore         Float?
  contentScore         Float?
  communicationScore   Float?
  aiFeedback           String?
  exchanges            VoiceExchange[]

  @@index([userId, startedAt])
}

model LearningPath {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  type          String
  name          String
  isActive      Boolean            @default(false)
  interviewDate DateTime?
  dailyHours    Float?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  progress      PathItemProgress[]

  @@index([userId])
  @@index([userId, isActive])
}

model PathItemProgress {
  id               String       @id @default(cuid())
  pathId           String
  path             LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  userId           String
  itemId           String
  itemType         String
  stage            Int
  status           String
  attempts         Int          @default(0)
  markedUnderstood Boolean      @default(false)
  passedAt         DateTime?
  understoodAt     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([pathId, itemId])
  @@index([pathId, stage])
  @@index([userId, pathId])
}

model LearnModuleProgress {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  moduleId         String
  status           String    @default("in_progress")
  currentStepIndex Int       @default(0)
  completedAt      DateTime?
  timeSpentMs      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, moduleId])
  @@index([userId])
}

model LearnConceptReview {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  conceptTag     String
  moduleId       String
  stepId         String
  reviewType     String
  reviewData     Json
  lastReviewedAt DateTime?
  nextReviewAt   DateTime
  intervalDays   Float     @default(1)
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  timesCorrect   Int       @default(0)
  timesIncorrect Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, stepId])
  @@index([userId, nextReviewAt])
  @@index([userId, conceptTag])
}

model LearnConceptWeight {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  conceptTag String
  weight     Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, conceptTag])
}

model LearnHintEvent {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  moduleId          String
  stepId            String
  stepType          String
  eventType         String
  mistakeKind       String?
  answerFingerprint String?
  hintsShown        Int      @default(0)
  revealed          Boolean  @default(false)
  eventuallyCorrect Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([stepId, eventType])
  @@index([moduleId, stepId])
  @@index([createdAt])
}

model PathStageItem {
  id          String   @id @default(cuid())
  pathType    String
  stage       Int
  itemId      String
  itemType    String
  mostAsked   Boolean  @default(false)
  order       Int
  aiEvaluated Boolean  @default(false)
  aiReasoning String?
  createdAt   DateTime @default(now())

  @@unique([pathType, itemId])
  @@index([pathType, stage])
}

model VoiceExchange {
  id                 String                @id @default(cuid())
  sessionId          String
  session            VoiceInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId         String?
  order              Int
  questionText       String
  questionType       String
  answerTranscript   String?
  answerAudioUrl     String?
  answerDurationSec  Float?
  fillerWordCount    Int?
  wordsPerMinute     Float?
  deepgramConfidence Float?
  aiContentScore     Float?
  aiContentFeedback  String?
  aiGaps             Json?
  createdAt          DateTime              @default(now())

  @@index([sessionId])
}
